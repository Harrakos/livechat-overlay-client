{
  "name": "livechatv2-client",
  "version": "1.0.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.livechatv2.overlayclient",
    "productName": "LiveChat Overlay",
    "files": [
      "src/**/*",
      "config.example.json"
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.utilities" },
    "linux": { "target": "AppImage" },
    "publish": {
      "provider": "github",
      "owner": "Harrakos",
      "repo": "livechat-overlay-client"
    }
  }
}
